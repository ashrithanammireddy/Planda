rules_version = '2';

// Planda Firestore security rules.
//
// The only data stored in the cloud is a user's public profile for the friends
// leaderboard (name, avatar, friend code, friends list, and stats). No email,
// passwords, or grades are stored here: those live in Firebase Auth or locally
// in the browser. When a user turns on "keep stats private," the app writes
// zeros for their stats before syncing, so private stats never reach Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile docs.
    match /users/{userId} {
      // Any signed-in user can read profiles. This is required so a student can
      // look someone up by their friend code to add them, and so friends'
      // public stats can appear on the leaderboard.
      allow read: if request.auth != null;

      // A user may only create or modify their OWN profile document, so no one
      // can edit, overwrite, or tamper with another student's data.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
